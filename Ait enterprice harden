#!/usr/bin/env bash
# ============================================================
# AIT Enterprise — GitHub Security Hardening Script
# Red Team 2026 Standards
#
# Prerequisites:
#   gh auth login   (GitHub CLI, authenticated as sashasmith-syber)
#   jq              (brew install jq / apt install jq)
#
# Usage:
#   chmod +x ait-enterprise-harden.sh
#   ./ait-enterprise-harden.sh
#
# What it does:
#   1. Applies branch protection to main/develop on all repos
#   2. Enables Dependabot alerts + security updates
#   3. Enables secret scanning + push protection
#   4. Enables vulnerability alerts
#   5. Disables public forks on SmithSolution org repos
#   6. Enforces 2FA requirement at org level
# ============================================================

set -euo pipefail

# ── Config ────────────────────────────────────────────────────
ORGS=("sashasmith-syber" "SmithSolution")
GITHUB_TOKEN="${GITHUB_TOKEN:-}"   # or use gh auth token

# Priority repos for CodeQL (add others as needed)
CODEQL_REPOS=(
  "sashasmith-syber/HIKARU-AI"
  "SmithSolution/PROTOS-1"
  "SmithSolution/hikaru-core"
  "sashasmith-syber/nexus_spider_agent"
  "SmithSolution/HIKARU-AI-v3.6_PROTOS-1"
)

# ── Colour output ─────────────────────────────────────────────
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

log_ok()   { echo -e "${GREEN}✅ $1${NC}"; }
log_warn() { echo -e "${YELLOW}⚠️  $1${NC}"; }
log_err()  { echo -e "${RED}❌ $1${NC}"; }
log_info() { echo -e "   ℹ️  $1"; }

# ── Auth check ────────────────────────────────────────────────
echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║   AIT Enterprise — GitHub Security Hardening         ║"
echo "║   Red Team 2026 Standards                            ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

if ! gh auth status &>/dev/null; then
  log_err "GitHub CLI not authenticated. Run: gh auth login"
  exit 1
fi

AUTHED_USER=$(gh api user --jq '.login')
log_ok "Authenticated as: $AUTHED_USER"
echo ""

# ── Helper: get all repos for an org/user ────────────────────
get_repos() {
  local owner="$1"
  gh repo list "$owner" --limit 100 --json nameWithOwner --jq '.[].nameWithOwner' 2>/dev/null || echo ""
}

# ── 1. Branch Protection ─────────────────────────────────────
apply_branch_protection() {
  local repo="$1"
  local branch="$2"

  # Check if branch exists
  if ! gh api "repos/$repo/branches/$branch" &>/dev/null; then
    log_warn "Branch '$branch' not found in $repo — skipping"
    return
  fi

  gh api \
    --method PUT \
    "repos/$repo/branches/$branch/protection" \
    --field required_status_checks='{"strict":true,"contexts":["CodeQL Security Scan","Dependency Review","Secret Scan"]}' \
    --field enforce_admins=true \
    --field required_pull_request_reviews='{"required_approving_review_count":1,"dismiss_stale_reviews":true,"require_code_owner_reviews":true,"require_last_push_approval":true}' \
    --field restrictions=null \
    --field required_linear_history=true \
    --field allow_force_pushes=false \
    --field allow_deletions=false \
    --field block_creations=false \
    --field required_conversation_resolution=true \
    --silent && log_ok "$repo → $branch protected" \
    || log_warn "$repo → $branch protection failed (may need Admin role)"
}

# ── 2. Enable Dependabot ─────────────────────────────────────
enable_dependabot() {
  local repo="$1"

  # Vulnerability alerts
  gh api \
    --method PUT \
    "repos/$repo/vulnerability-alerts" \
    --silent 2>/dev/null && log_ok "$repo → vulnerability alerts enabled" \
    || log_warn "$repo → vulnerability alerts skipped"

  # Automated security fixes
  gh api \
    --method PUT \
    "repos/$repo/automated-security-fixes" \
    --silent 2>/dev/null && log_ok "$repo → automated security fixes enabled" \
    || log_warn "$repo → automated security fixes skipped"
}

# ── 3. Enable Secret Scanning ────────────────────────────────
enable_secret_scanning() {
  local repo="$1"

  gh api \
    --method PATCH \
    "repos/$repo" \
    --field security_and_analysis='{"secret_scanning":{"status":"enabled"},"secret_scanning_push_protection":{"status":"enabled"}}' \
    --silent 2>/dev/null && log_ok "$repo → secret scanning + push protection enabled" \
    || log_warn "$repo → secret scanning skipped (may require GHAS license)"
}

# ── 4. Repo settings hardening ───────────────────────────────
harden_repo_settings() {
  local repo="$1"

  gh api \
    --method PATCH \
    "repos/$repo" \
    --field delete_branch_on_merge=true \
    --field allow_squash_merge=true \
    --field allow_merge_commit=false \
    --field allow_rebase_merge=false \
    --field allow_auto_merge=false \
    --silent 2>/dev/null && log_ok "$repo → repo settings hardened" \
    || log_warn "$repo → settings update skipped"
}

# ── 5. Org-level 2FA enforcement ─────────────────────────────
enforce_org_2fa() {
  local org="$1"

  gh api \
    --method PATCH \
    "orgs/$org" \
    --field two_factor_requirement_enabled=true \
    --silent 2>/dev/null && log_ok "$org → 2FA enforcement enabled" \
    || log_warn "$org → 2FA enforcement skipped (requires org owner)"
}

# ── 6. Disable public forks for SmithSolution ────────────────
disable_public_forks() {
  local repo="$1"

  gh api \
    --method PATCH \
    "repos/$repo" \
    --field allow_forking=false \
    --silent 2>/dev/null && log_ok "$repo → public forking disabled" \
    || log_warn "$repo → fork disable skipped"
}

# ── Main execution loop ───────────────────────────────────────
TOTAL=0
SUCCESS=0

for org in "${ORGS[@]}"; do
  echo ""
  echo "──────────────────────────────────────────────────────"
  echo "  Processing org: $org"
  echo "──────────────────────────────────────────────────────"

  # Org-level settings
  enforce_org_2fa "$org"

  # Get all repos
  repos=$(get_repos "$org")

  if [ -z "$repos" ]; then
    log_warn "No repos found for $org (check permissions)"
    continue
  fi

  while IFS= read -r repo; do
    [ -z "$repo" ] && continue
    TOTAL=$((TOTAL + 1))

    echo ""
    log_info "Processing: $repo"

    # Branch protection
    apply_branch_protection "$repo" "main"
    apply_branch_protection "$repo" "develop"

    # Security features
    enable_dependabot "$repo"
    enable_secret_scanning "$repo"
    harden_repo_settings "$repo"

    # Disable forking on SmithSolution (IP protection)
    if [[ "$org" == "SmithSolution" ]]; then
      disable_public_forks "$repo"
    fi

    SUCCESS=$((SUCCESS + 1))

  done <<< "$repos"
done

# ── Copy security files to all repos ─────────────────────────
echo ""
echo "──────────────────────────────────────────────────────"
echo "  Pushing security files to priority repos"
echo "──────────────────────────────────────────────────────"

SECURITY_FILES_TO_PUSH=(
  ".github/dependabot.yml"
  ".github/workflows/codeql.yml"
  ".github/workflows/dependency-review.yml"
  ".github/workflows/secret-scan.yml"
  ".github/CODEOWNERS"
  "SECURITY.md"
)

for repo in "${CODEQL_REPOS[@]}"; do
  echo ""
  log_info "Pushing security files → $repo"

  for file in "${SECURITY_FILES_TO_PUSH[@]}"; do
    if [ -f "$file" ]; then
      # Check if file exists in repo
      existing_sha=$(gh api "repos/$repo/contents/$file" --jq '.sha' 2>/dev/null || echo "")
      
      encoded_content=$(base64 -w 0 < "$file")
      
      if [ -n "$existing_sha" ]; then
        gh api \
          --method PUT \
          "repos/$repo/contents/$file" \
          --field message="chore(security): update AIT Red Team 2026 security config" \
          --field content="$encoded_content" \
          --field sha="$existing_sha" \
          --silent 2>/dev/null && log_ok "Updated $file in $repo" \
          || log_warn "Failed to update $file in $repo"
      else
        gh api \
          --method PUT \
          "repos/$repo/contents/$file" \
          --field message="chore(security): add AIT Red Team 2026 security config" \
          --field content="$encoded_content" \
          --silent 2>/dev/null && log_ok "Added $file to $repo" \
          || log_warn "Failed to add $file to $repo"
      fi
    fi
  done
done

# ── Summary ───────────────────────────────────────────────────
echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║   AIT Enterprise Hardening — Complete                ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""
echo "  Repositories processed : $TOTAL"
echo "  Successfully hardened  : $SUCCESS"
echo ""
echo "  Applied:"
echo "  ✅ Branch protection (main + develop) with required reviews"
echo "  ✅ Dependabot alerts + automated security fixes"
echo "  ✅ Secret scanning + push protection"
echo "  ✅ Delete branch on merge"
echo "  ✅ Squash-only merges (linear history)"
echo "  ✅ 2FA enforcement at org level"
echo "  ✅ Public fork disabled (SmithSolution)"
echo "  ✅ Security files pushed to priority repos"
echo ""
echo "  Manual steps remaining:"
echo "  → Enterprise → Settings → Authentication → Enable SAML SSO"
echo "  → Enterprise → Settings → IP allowlist → Add Cloudflare WARP IPs"  
echo "  → Enterprise → Settings → Audit log → Enable streaming to Supabase"
echo "  → Add STAINLESS_API_KEY secret to HIKARU-AI repo"
echo "  → Add PERPLEXITY_API_KEY secret to HIKARU-AI repo"
echo ""
echo "  光即知識 — AIT Sanctuary Protocol Active"
echo ""
